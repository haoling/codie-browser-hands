{
  "manifest_version": 3,
  "name": "Codie Chrome Tools",
  "version": "0.1.0",
  "description": "CodieがこのChromeを操作できるようにする外部ツール(ベータ)。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "popup/popup.html", "default_title": "Codie Chrome Tools" }
}
