{
  "manifest_version": 3,
  "name": "Codie Browser Hands",
  "version": "0.1.2",
  "description": "CodieがこのChromeを操作できるようにする外部ツール(ベータ)。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "scripting", "alarms", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "popup/popup.html", "default_title": "Codie Browser Hands" }
}
